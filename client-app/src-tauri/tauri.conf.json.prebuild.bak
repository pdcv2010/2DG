{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel",
  "version": "1.0.0",
  "identifier": "com.sentinelgate.desktop",
  "build": {
    "frontendDist": "../../release/client-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SentinelGate",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 700,
        "url": "GUI/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; script-src 'self' 'unsafe-inline' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
