.sg-entering .feature-card { animation: sgRise .6s var(--sg-ease) both; }
.sg-entering .feature-card:nth-child(1) { animation-delay: 150ms; }
.sg-entering .feature-card:nth-child(2) { animation-delay: 210ms; }
.sg-entering .feature-card:nth-child(3) { animation-delay: 270ms; }
.sg-entering .feature-card:nth-child(4) { animation-delay: 330ms; }

.sg-entering .account-summary { animation: sgSlideRight .6s var(--sg-ease) 340ms both; }
.sg-entering .summary-metric { animation: sgRiseSoft .5s var(--sg-ease) both; }
.sg-entering .summary-metric:nth-child(1) { animation-delay: 420ms; }
.sg-entering .summary-metric:nth-child(2) { animation-delay: 480ms; }
.sg-entering .summary-metric:nth-child(3) { animation-delay: 540ms; }
.sg-entering .summary-metric:nth-child(4) { animation-delay: 600ms; }
.sg-entering .home-recent-activity { animation: sgRiseSoft .55s var(--sg-ease) 660ms both; }
.sg-entering .home-footer { animation: sgRiseSoft .5s var(--sg-ease) 720ms both; }

/* Other workspaces reuse the same vocabulary. */
.sg-entering .protection-page-heading,
.sg-entering .history-page-heading,
.sg-entering .vault-page-heading { animation: sgRiseSoft .55s var(--sg-ease) 40ms both; }
.sg-entering .protect-panel { animation: sgRise .6s var(--sg-ease) 130ms both; }
.sg-entering .protection-action-row { animation: sgRiseSoft .5s var(--sg-ease) 280ms both; }
.sg-entering .restore-workflow { animation: sgRise .6s var(--sg-ease) 180ms both; }
.sg-entering .history-panel,
.sg-entering .vault-panel { animation: sgRise .6s var(--sg-ease) 110ms both; }
.sg-entering .settings-panel,
.sg-entering .about-panel { animation: sgRise .55s var(--sg-ease) both; }
.sg-entering .settings-panel:nth-child(2),
.sg-entering .about-panel:nth-child(2) { animation-delay: 60ms; }
.sg-entering .settings-panel:nth-child(3),
.sg-entering .about-panel:nth-child(3) { animation-delay: 120ms; }
.sg-entering .settings-panel:nth-child(4),
.sg-entering .about-panel:nth-child(4) { animation-delay: 180ms; }
.sg-entering .settings-panel:nth-child(5),
.sg-entering .about-panel:nth-child(5) { animation-delay: 240ms; }

/* List items enter with a short, capped stagger. Items beyond the cap stay
   static so large lists never animate in bulk. */
.vault-file-card,
.history-row,
.restore-file-item,
.music-result { animation: sgRiseSoft .42s var(--sg-ease) both; }
.vault-file-card:nth-child(n+13),
.history-row:nth-child(n+13),
.restore-file-item:nth-child(n+13) { animation: none; }
.history-row:nth-child(2), .vault-file-card:nth-child(2) { animation-delay: 30ms; }
.history-row:nth-child(3), .vault-file-card:nth-child(3) { animation-delay: 60ms; }
.history-row:nth-child(4), .vault-file-card:nth-child(4) { animation-delay: 90ms; }
.history-row:nth-child(5), .vault-file-card:nth-child(5) { animation-delay: 120ms; }
.history-row:nth-child(6), .vault-file-card:nth-child(6) { animation-delay: 150ms; }
.history-row:nth-child(7), .vault-file-card:nth-child(7) { animation-delay: 180ms; }
.history-row:nth-child(8), .vault-file-card:nth-child(8) { animation-delay: 210ms; }
.history-row:nth-child(9), .vault-file-card:nth-child(9) { animation-delay: 240ms; }
.history-row:nth-child(10), .vault-file-card:nth-child(10) { animation-delay: 270ms; }
.history-row:nth-child(11), .vault-file-card:nth-child(11) { animation-delay: 300ms; }
.history-row:nth-child(12), .vault-file-card:nth-child(12) { animation-delay: 330ms; }

/* Tab switching: the existing class contract and its 130ms out-phase are
   preserved, only the travel and the entry curve are refined. No static
   transform is declared, so no fixed-position child is ever re-anchored. */
.tab-view {
    opacity: 1;
    transition: opacity 340ms var(--sg-ease-tab), transform 340ms var(--sg-ease-tab);
}

.tab-view.is-transitioning-out {
    opacity: 0;
    transform: translateY(6px) scale(.995);
    transition-duration: 130ms;
}

.tab-view.is-transitioning-in {
    opacity: 0;
    transform: translateY(8px);
}

/* ------------------------------------------------------------------
   GLASS CONTROLS - buttons, status lights, loading and result states.
   ------------------------------------------------------------------ */

/* Secondary glass controls */
.text-link,
.social-button,
.history-refresh,
.history-detail-button,
.history-dialog-close,
.vault-restore-button,
.settings-action,
.manage-account,
.restore-refresh,
.processing-error button {
    border-color: var(--glass-border);
    background-image: var(--glass-bg);
    background-repeat: no-repeat;
    box-shadow: inset 0 1px var(--glass-highlight), 0 10px 24px rgba(0, 0, 0, .26);
    transition: transform .2s var(--sg-ease-tab), border-color .2s var(--sg-ease-tab), box-shadow .2s var(--sg-ease-tab), filter .2s var(--sg-ease-tab);
}

.text-link:hover,
.social-button:hover,
.history-refresh:hover,
.history-detail-button:hover,
.history-dialog-close:hover,
.vault-restore-button:hover,
.settings-action:hover,
.manage-account:hover,
.restore-refresh:hover,
.processing-error button:hover {
    transform: translateY(-1px);
    border-color: var(--glass-border-strong);
    box-shadow: inset 0 1px var(--glass-highlight), 0 14px 30px rgba(0, 0, 0, .32);
    filter: brightness(1.06);
}

/* Primary actions: lit from inside the glass, not solid neon. */
.primary-button,
.welcome-button,
.start-protection-button,
.history-primary-action {
    border-color: rgba(34, 211, 238, .34);
    background-image: linear-gradient(180deg, rgba(34, 211, 238, .3), rgba(34, 211, 238, .1)), var(--glass-bg);
    background-repeat: no-repeat;
    box-shadow: inset 0 1px rgba(255, 255, 255, .24), 0 12px 32px rgba(34, 211, 238, .16);
    color: #eafdff;
    transition: transform .2s var(--sg-ease-tab), box-shadow .2s var(--sg-ease-tab), filter .2s var(--sg-ease-tab), border-color .2s var(--sg-ease-tab);
}

.primary-button:hover,
.welcome-button:hover,
.start-protection-button:hover,
.history-primary-action:hover {
    transform: translateY(-1px);
    border-color: rgba(34, 211, 238, .5);
    box-shadow: inset 0 1px rgba(255, 255, 255, .28), 0 16px 40px rgba(34, 211, 238, .22);
    filter: brightness(1.07);
}

.start-protection-button:active,
.primary-button:active,
.welcome-button:active { transform: translateY(0) scale(.99); }

/* Destructive action keeps its meaning. */
.settings-logout,
.settings-action.is-danger {
    border-color: rgba(255, 117, 143, .3);
    background-image: linear-gradient(180deg, rgba(255, 92, 118, .2), rgba(255, 92, 118, .07)), var(--glass-bg);
    box-shadow: inset 0 1px rgba(255, 255, 255, .16), 0 10px 26px rgba(120, 20, 40, .22);
    color: #ffc9d3;
}

/* Status lights - calm, never blinking. */
.welcome-kicker i,
.feature-meta i,
.system-ok i { box-shadow: 0 0 10px rgba(67, 225, 174, .55); }
.history-status.is-completed,
.vault-file-status { box-shadow: 0 0 0 1px rgba(52, 211, 153, .1); }
.history-status.is-processing {
    border-color: rgba(34, 211, 238, .3);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, .1);
}
.settings-status-row[data-state="pending"] .settings-status-dot { animation: sgPulse 2.8s ease-in-out infinite; }

/* Loading: one travelling shimmer per state. */
.history-spinner,
.restore-empty-state.is-loading::before,
.music-search-status.is-loading::before { border-top-color: #22d3ee; }
.history-state,
.vault-state { font-family: inherit; }
.history-state:has(.history-spinner),
.vault-state.is-loading { position: relative; overflow: hidden; }
.history-state:has(.history-spinner)::after,
.vault-state.is-loading::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(100deg, transparent 32%, rgba(255, 255, 255, .05) 50%, transparent 68%);
    transform: translateX(-120%);
    animation: sgShimmer 2.8s ease-in-out infinite;
}

/* Real progress bar, illuminated. */
.processing-track {
    border-color: var(--glass-border);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, .05), rgba(255, 255, 255, .02));
    box-shadow: inset 0 1px rgba(0, 0, 0, .42);
}
.processing-track i {
    background-image: linear-gradient(90deg, rgba(59, 130, 246, .95), #22d3ee);
    box-shadow: 0 0 16px rgba(34, 211, 238, .42);
}
.processing-percent { color: #eafdff; text-shadow: 0 0 26px rgba(34, 211, 238, .3); }
.processing-details { color: #9fbcc6; }

/* Stage scale for the real progress bar: labels, not a fake indicator. */
.stage-set { display: flex; width: 100%; margin-top: 10px; gap: 6px; }
.stage-set.is-restore { display: none; }
#protectionPage[data-mode="restore"] .stage-set.is-protect { display: none; }
#protectionPage[data-mode="restore"] .stage-set.is-restore { display: flex; }
.stage-set span {
    flex: 1 1 0;
    min-width: 0;
    padding: 7px 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .09);
    border-radius: 10px;
    background-image: var(--glass-bg);
    color: #8fb0ba;
    font: 600 8px Arial, sans-serif;
    letter-spacing: .07em;
    text-align: center;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

/* Completion - only fires when the real success block appears. */
.processing-complete:not(.hidden) { animation: sgPopIn .5s var(--sg-ease) both; }
.processing-complete::before {
    content: "✓";
    display: grid;
    width: 34px;
    height: 34px;
    margin-bottom: 2px;
    place-items: center;
    border: 1px solid rgba(52, 211, 153, .34);
    border-radius: 50%;
    background: rgba(52, 211, 153, .13);
    color: #6ee7b7;
    font: 700 16px Arial, sans-serif;
    animation: sgPopIn .5s var(--sg-ease) .12s both;
}

/* Error: clear and calm, no screen shake. */
.processing-error > span { animation: sgPopIn .4s var(--sg-ease) both, sgPulse 3.4s ease-in-out .6s infinite; }
.processing-error p { color: #e0b4bd; }
.restore-empty-state.is-error { border-color: rgba(255, 117, 143, .24); }

/* ------------------------------------------------------------------
   NAVIGATION, RESPONSIVE WEIGHT AND PERFORMANCE GUARDS
   ------------------------------------------------------------------ */

/* Dock micro-interaction - navigation targets are unchanged. */
.tool-nav-item:hover .tool-nav-icon svg { transform: translateY(-2px) scale(1.06); }
.tool-nav-item.is-current .tool-nav-icon svg { filter: drop-shadow(0 0 8px rgba(34, 211, 238, .35)); }

/* Responsive: lighter glass on smaller viewports. */
@media (max-width: 1024px) {
    :root { --glass-blur: 13px; --glass-blur-strong: 20px; }
}

@media (max-width: 700px) {
    :root { --glass-blur: 12px; --glass-blur-strong: 17px; }
    .sg-aurora > span:nth-child(3) { display: none; }
    .stage-set { flex-wrap: wrap; }
    .stage-set span { flex: 1 1 28%; }
}

@media (max-width: 420px) {
    .settings-panel,
    .about-panel,
    .history-panel,
    .protect-panel { backdrop-filter: none; -webkit-backdrop-filter: none; }
}

/* The automatic lightweight profile and the manual "reduce blur" setting
   share one recipe: keep the layering, drop every blur. */
html[data-performance-mode="lightweight"] :is(.feature-card, .account-summary, .protect-panel, .file-dropzone, .history-panel, .vault-file-card, .history-row, .settings-panel, .about-panel, .settings-row, .restore-workflow, .restore-file-item, .music-result, .mode-toggle, .history-dialog, .processing-complete, .processing-error, .app-notice, .auth-container, .dashboard-dock, .tool-nav-label),
html[data-sg-effects="reduced"] :is(.feature-card, .account-summary, .protect-panel, .file-dropzone, .history-panel, .vault-file-card, .history-row, .settings-panel, .about-panel, .settings-row, .restore-workflow, .restore-file-item, .music-result, .mode-toggle, .history-dialog, .processing-complete, .processing-error, .app-notice, .auth-container, .dashboard-dock, .tool-nav-label) {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .028)), linear-gradient(180deg, rgba(9, 16, 26, .9), rgba(7, 12, 20, .92));
    box-shadow: inset 0 1px rgba(255, 255, 255, .07), 0 14px 34px rgba(0, 0, 0, .4);
}

html[data-performance-mode="lightweight"] .sg-aurora { background: #05080e; }

html[data-performance-mode="lightweight"] .sg-aurora > span,
html[data-sg-effects="reduced"] .sg-aurora > span { animation: none; }

/* OLED mode from Settings stays coherent with the new surfaces. */
html[data-sg-dark="oled"] .home-page,
html[data-sg-dark="oled"] .auth-page { background: rgba(0, 0, 0, .84); }
html[data-sg-dark="oled"] .sg-aurora { opacity: .4; }
html[data-sg-dark="oled"] :is(.feature-card, .account-summary, .history-panel, .settings-panel, .about-panel) {
    background-image: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .02)), linear-gradient(180deg, rgba(4, 6, 9, .92), rgba(2, 4, 6, .94));
}

/* Reduced motion: every decorative layer stops, the app stays fully usable. */
@media (prefers-reduced-motion: reduce) {
    .sg-aurora > span { animation: none; will-change: auto; }
    .sg-entering .dashboard-dock,
    .sg-entering .dashboard-dock::after,
    .sg-entering .home-header,
    .sg-entering .home-welcome,
    .sg-entering .feature-card,
    .sg-entering .account-summary,
    .sg-entering .summary-metric,
    .sg-entering .home-recent-activity,
    .sg-entering .home-footer,
    .sg-entering .protect-panel,
    .sg-entering .protection-action-row,
    .sg-entering .restore-workflow,
    .sg-entering .history-panel,
    .sg-entering .vault-panel,
    .sg-entering .settings-panel,
    .sg-entering .about-panel,
    .sg-entering .protection-page-heading,
    .sg-entering .history-page-heading,
    .sg-entering .vault-page-heading { animation: none; }
    .vault-file-card,
    .history-row,
    .restore-file-item,
    .music-result,
    .history-state:has(.history-spinner)::after,
    .vault-state.is-loading::after,
    .history-status.is-processing,
    .settings-status-row[data-state="pending"] .settings-status-dot,
    .processing-error > span,
    .processing-complete::before,
    .processing-complete:not(.hidden) { animation: none; }
    .tab-view,
    .tab-view.is-transitioning-out,
    .tab-view.is-transitioning-in { transition-duration: 1ms; }
}

/* Login / register shell joins the glass system; its opaque scrim becomes
   transparent so the aurora and the frosted card read as one surface. */
.auth-stage .auth-container {
    background-image: var(--glass-bg), radial-gradient(120% 120% at 90% 0%, var(--glass-tint), transparent 62%);
    background-position: 0 0, 0 0;
    background-repeat: no-repeat;
    border-color: var(--glass-border);
    box-shadow: 0 34px 90px rgba(0, 0, 0, .58), inset 0 1px var(--glass-highlight);
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(115%);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(115%);
}

.auth-stage .auth-container::before { background: transparent; }

/* =====================================================
   ABOUT — INTERACTIVE LINUX TERMINAL
   All About page selectors stay under #aboutPage.
   ===================================================== */
#aboutPage {
    --sgx-mono: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, "DejaVu Sans Mono", monospace;
    --sgx-cyan: #6ce9ff;
    --sgx-violet: #b48cff;
    --sgx-green: #7df3b0;
    --sgx-amber: #f7ce7c;
    --sgx-text: #e4f3ff;
    --sgx-dim: #92a7c6;
    --sgx-border: rgba(150, 132, 255, .26);
    --sgx-border-hi: rgba(108, 233, 255, .58);
    --sgx-glass: linear-gradient(180deg, rgba(26, 19, 50, .74), rgba(7, 9, 18, .84));
    --sgx-ease: cubic-bezier(.16, 1, .3, 1);

    position: fixed;
    z-index: 10;
    inset: 0;
    display: flex;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
    padding: clamp(8px, 1.5vh, 16px) clamp(8px, 1.5vw, 18px);
    flex-direction: column;
    gap: 0;
    background:
        radial-gradient(120% 88% at 10% 4%, rgba(108, 233, 255, .055), transparent 58%),
        radial-gradient(110% 92% at 94% 98%, rgba(167, 120, 255, .07), transparent 62%),
        #070912;
    color: #e4f3ff;
    font-family: var(--sgx-mono);
    overscroll-behavior: none;
    scrollbar-width: none;
}

#aboutPage::-webkit-scrollbar { display: none; }

#aboutPage .sgx-stage {
    display: flex;
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
}

#aboutPage .sgx-split {
    position: relative;
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    gap: clamp(5px, .75vw, 12px);
}

#aboutPage .sgx-split[data-dir="row"] { flex-direction: row; }
#aboutPage .sgx-split[data-dir="column"] { flex-direction: column; }
#aboutPage .sgx-stage > *,
#aboutPage .sgx-split > * { flex: 1 1 0; min-width: 0; min-height: 0; }

#aboutPage .sgx-split::before {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(180deg, transparent, var(--sgx-border-hi), transparent);
    content: "";
}

#aboutPage .sgx-split[data-dir="row"]::before {
    top: 8px;
    bottom: 8px;
    left: 50%;
    width: 1px;
    transform: translateX(-50%) scaleY(0);
}

#aboutPage .sgx-split[data-dir="column"]::before {
    top: 50%;
    right: 8px;
    left: 8px;
    height: 1px;
    transform: translateY(-50%) scaleX(0);
    background: linear-gradient(90deg, transparent, var(--sgx-border-hi), transparent);
}

#aboutPage .sgx-split.is-splitting[data-dir="row"]::before { animation: sgxSeamRow .5s var(--sgx-ease) both; }
#aboutPage .sgx-split.is-splitting[data-dir="column"]::before { animation: sgxSeamCol .5s var(--sgx-ease) both; }

#aboutPage .sgx-leaf {
    position: relative;
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--sgx-border);
    border-radius: 13px;
    background: var(--sgx-glass);
    box-shadow: inset 0 1px rgba(255, 255, 255, .045), 0 8px 24px rgba(0, 0, 0, .2);
    container-type: size;
    transition: border-color .22s var(--sgx-ease), transform .22s var(--sgx-ease), opacity .22s linear;
}

#aboutPage .sgx-leaf::before {
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, .018) 0 1px, transparent 1px 4px);
    content: "";
}

#aboutPage .sgx-leaf::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    transform: translateX(-120%);
    pointer-events: none;
    background: linear-gradient(105deg, transparent 0%, rgba(108, 233, 255, .075) 48%, transparent 100%);
    content: "";
    opacity: 0;
}

#aboutPage .sgx-leaf.is-open { cursor: pointer; border-color: rgba(150, 132, 255, .4); }
#aboutPage .sgx-leaf.is-open:hover,
#aboutPage .sgx-leaf.is-open:focus-visible { transform: translateY(-1px); border-color: var(--sgx-border-hi); }
#aboutPage .sgx-leaf.is-open:hover::after { animation: sgxSheen .55s var(--sgx-ease) 1; }
#aboutPage .sgx-leaf:focus-visible { outline: 2px solid var(--sgx-cyan); outline-offset: 2px; }

#aboutPage .sgx-leaf.is-glitch > .sgx-screen { animation: sgxGlitch .19s steps(2, end) 1; }
#aboutPage .sgx-split.is-splitting > :first-child { border-color: var(--sgx-border-hi); animation: sgxKeepIn .48s var(--sgx-ease) both; }
#aboutPage .sgx-split.is-splitting[data-dir="row"] > :last-child { animation: sgxInRight .5s var(--sgx-ease) both; }
#aboutPage .sgx-split.is-splitting[data-dir="column"] > :last-child { animation: sgxInDown .5s var(--sgx-ease) both; }

#aboutPage .sgx-bar {
    display: flex;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border-bottom: 1px solid rgba(150, 132, 255, .16);
    background: linear-gradient(180deg, rgba(255, 255, 255, .04), transparent);
    color: var(--sgx-dim);
    font: 10px/1.25 var(--sgx-mono);
    white-space: nowrap;
}

#aboutPage .sgx-bar-dots { display: inline-flex; flex: 0 0 auto; gap: 4px; }
#aboutPage .sgx-bar-dots i { width: 7px; height: 7px; border-radius: 50%; background: #4a4270; }
#aboutPage .sgx-bar-dots i:nth-child(1) { background: #ff6b81; }
#aboutPage .sgx-bar-dots i:nth-child(2) { background: #ffc46b; }
#aboutPage .sgx-bar-dots i:nth-child(3) { background: #7df3b0; }
#aboutPage .sgx-bar-path { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
#aboutPage .sgx-bar-hint { display: none; margin-left: auto; color: rgba(146, 167, 198, .75); font-size: .9em; }
#aboutPage .sgx-leaf.is-open .sgx-bar-hint { display: inline; }
#aboutPage .sgx-bar-cue { display: none; margin-left: auto; color: var(--sgx-cyan); opacity: 0; transition: opacity .18s linear; }
#aboutPage .sgx-leaf.is-open .sgx-bar-cue { display: inline; }
#aboutPage .sgx-leaf.is-open:hover .sgx-bar-cue,
#aboutPage .sgx-leaf.is-open:focus-visible .sgx-bar-cue { opacity: 1; }
#aboutPage .sgx-leaf.is-open:hover .sgx-bar-hint { color: var(--sgx-cyan); }

#aboutPage .sgx-screen {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: clamp(3px, .65cqh, 7px);
    overflow: hidden;
    padding: clamp(7px, 1.2cqh, 13px) clamp(7px, 1cqw, 14px);
    color: var(--sgx-text);
    font-family: var(--sgx-mono);
}

#aboutPage .sgx-log {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    overflow: hidden;
    transition: opacity .24s linear;
}
#aboutPage .sgx-log.is-fading { opacity: 0; }
#aboutPage .sgx-line { display: flex; align-items: baseline; gap: 5px; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
#aboutPage .sgx-line.is-new { animation: sgxLineIn .18s ease-out both; }
#aboutPage .sgx-line.is-check { color: #cfe4f7; }
#aboutPage .sgx-ps1 { flex: 0 0 auto; color: var(--sgx-green); }
#aboutPage .sgx-typed { white-space: pre-wrap; }
#aboutPage .sgx-marker,
#aboutPage .sgx-tag,
#aboutPage .sgx-value { color: var(--sgx-green); }
#aboutPage .sgx-lead { min-width: 8px; flex: 1 1 auto; transform: translateY(-.3em); border-bottom: 1px dotted rgba(150, 132, 255, .35); }
#aboutPage .sgx-ready { flex: 0 0 auto; }
#aboutPage .sgx-caret { display: inline-block; width: .58em; color: var(--sgx-cyan); animation: sgxCaret 1.05s steps(1, end) infinite; }
#aboutPage .sgx-brand-art {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2.2cqh, 24px);
    overflow: hidden;
    padding: 8px;
}
#aboutPage .sgx-brand-art.is-off,
#aboutPage .sgx-log.is-off,
#aboutPage .sgx-ready.is-off { display: none; }
#aboutPage .sgx-brand-logo {
    width: min(52cqw, 280px);
    max-width: 72%;
    max-height: 52cqh;
}
#aboutPage .sgx-brand-wordmark {
    width: min(42cqw, 220px);
    max-width: 65%;
    max-height: 14cqh;
}
#aboutPage .sgx-brand-logo {
    display: block;
    width: auto !important;
    height: min(34cqh, 320px) !important;
    max-width: 55% !important;
    max-height: 42% !important;
    object-fit: contain !important;
    object-position: center;
}

#aboutPage .sgx-brand-wordmark {
    display: block;
    width: min(300px, 48%) !important;
    height: auto !important;
    max-width: 48% !important;
    max-height: 14% !important;
    object-fit: contain !important;
    object-position: center;
}
#aboutPage .sgx-brand-logo.is-off,
#aboutPage .sgx-brand-wordmark.is-off { display: none; }

#aboutPage .sgx-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
#aboutPage .sgx-content { display: flex; min-height: 0; flex: 1 1 auto; flex-direction: column; gap: clamp(3px, .6cqh, 6px); overflow: hidden; animation: sgxContentIn .34s var(--sgx-ease) both; }
#aboutPage .sgx-head { margin: 0; color: var(--sgx-text); font: 700 1em/1.3 var(--sgx-mono); letter-spacing: .06em; overflow-wrap: anywhere; }
#aboutPage .sgx-head span { color: var(--sgx-violet); }
#aboutPage .sgx-cmd { margin: 0; color: var(--sgx-dim); overflow-wrap: anywhere; }
#aboutPage .sgx-note { margin: 0; color: rgba(146, 167, 198, .85); font-size: .82em; overflow-wrap: anywhere; }
#aboutPage .sgx-pipe { display: flex; min-height: 0; flex-direction: column; gap: 2px; margin: 0; padding: 0; overflow: hidden; list-style: none; }
#aboutPage .sgx-step { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; gap: 2px 6px; animation: sgxStepIn .3s var(--sgx-ease) both; animation-delay: calc(100ms + var(--i, 0) * 45ms); }
#aboutPage .sgx-step-n { color: var(--sgx-cyan); }
#aboutPage .sgx-step-t { color: var(--sgx-text); font-weight: 700; letter-spacing: .02em; overflow-wrap: anywhere; }
#aboutPage .sgx-step-d { grid-column: 2; color: var(--sgx-dim); font-size: .88em; overflow-wrap: anywhere; }
#aboutPage .sgx-arrow { display: none; }
#aboutPage .sgx-kv { display: flex; min-height: 0; flex-direction: column; gap: 3px; overflow: hidden; }
#aboutPage .sgx-row { display: grid; grid-template-columns: minmax(0, auto) minmax(4px, 1fr) minmax(0, auto); align-items: baseline; gap: 3px; }
#aboutPage .sgx-row-k { color: var(--sgx-dim); overflow-wrap: anywhere; }
#aboutPage .sgx-row-lead { min-width: 3px; transform: translateY(-.3em); border-bottom: 1px dotted rgba(150, 132, 255, .32); }
#aboutPage .sgx-row-v { color: var(--sgx-text); text-align: right; overflow-wrap: anywhere; }
#aboutPage .sgx-row-v.is-todo { color: var(--sgx-amber); }
#aboutPage .sgx-members { display: flex; min-height: 0; flex-direction: column; gap: 2px; margin: 0; padding: 0; overflow: hidden; list-style: none; }
#aboutPage .sgx-member { color: var(--sgx-text); overflow-wrap: anywhere; animation: sgxStepIn .26s var(--sgx-ease) both; animation-delay: calc(120ms + var(--i, 0) * 45ms); }
#aboutPage .sgx-member::before { color: var(--sgx-cyan); content: "› "; }
#aboutPage .sgx-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 1px; }
#aboutPage .sgx-chip { padding: 2px 5px; border: 1px solid rgba(150, 132, 255, .28); border-radius: 5px; background: rgba(255, 255, 255, .035); color: var(--sgx-text); font-size: .85em; text-decoration: none; overflow-wrap: anywhere; }
#aboutPage .sgx-chip.is-todo { border-style: dashed; color: var(--sgx-amber); }
#aboutPage a.sgx-chip:hover,
#aboutPage a.sgx-chip:focus-visible { border-color: var(--sgx-border-hi); background: rgba(108, 233, 255, .08); }

#aboutPage .sgx-log.is-off,
#aboutPage .sgx-ready.is-off { display: none; }

@media (max-width: 760px) {
    #aboutPage { padding: 7px; }
    #aboutPage .sgx-split { gap: 4px; }
    #aboutPage .sgx-bar { gap: 4px; padding: 5px 6px; font-size: 8px; }
    #aboutPage .sgx-bar-hint { display: none !important; }
    #aboutPage .sgx-step-d,
    #aboutPage .sgx-note { font-size: .78em; }
    #aboutPage .sgx-brand-logo { width: min(46cqw, 180px); max-height: 42cqh; }
    #aboutPage .sgx-brand-wordmark { width: min(78cqw, 280px); max-height: 16cqh; }
}

@media (max-width: 420px) {
    #aboutPage { padding: 4px; }
    #aboutPage .sgx-leaf { border-radius: 9px; }
    #aboutPage .sgx-bar { gap: 3px; padding: 4px; font-size: 7px; }
    #aboutPage .sgx-bar-dots { gap: 2px; }
    #aboutPage .sgx-bar-dots i { width: 5px; height: 5px; }
    #aboutPage .sgx-screen { padding: 5px 4px; }
    #aboutPage .sgx-row { grid-template-columns: minmax(0, 1fr); gap: 0; }
    #aboutPage .sgx-row-lead { display: none; }
    #aboutPage .sgx-row-v { text-align: left; }
}

@container (max-height: 330px) {
    #aboutPage .sgx-step-d,
    #aboutPage .sgx-note { display: none; }
}

@container (max-height: 240px) {
    #aboutPage .sgx-cmd,
    #aboutPage .sgx-row.is-secondary { display: none; }
    #aboutPage .sgx-content,
    #aboutPage .sgx-kv,
    #aboutPage .sgx-members,
    #aboutPage .sgx-pipe { gap: 0; }
}

@media (prefers-reduced-motion: reduce) {
    #aboutPage .sgx-leaf,
    #aboutPage .sgx-leaf::after,
    #aboutPage .sgx-brand-logo,
    #aboutPage .sgx-brand-wordmark,
    #aboutPage .sgx-content,
    #aboutPage .sgx-step,
    #aboutPage .sgx-member,
    #aboutPage .sgx-line.is-new,
    #aboutPage .sgx-split.is-splitting > :first-child,
    #aboutPage .sgx-split.is-splitting > :last-child,
    #aboutPage .sgx-split.is-splitting::before,
    #aboutPage .sgx-leaf.is-glitch > .sgx-screen { animation: none; }
    #aboutPage .sgx-caret { animation: none; opacity: 1; }
    #aboutPage .sgx-leaf.is-open:hover { transform: none; }
    #aboutPage .sgx-leaf.is-open:hover::after { opacity: 0; }
    #aboutPage .sgx-split.is-splitting > :first-child { border-color: var(--sgx-border); }
}

html[data-performance-mode="lightweight"] #aboutPage .sgx-leaf,
html[data-sg-effects="reduced"] #aboutPage .sgx-leaf {
    background: rgba(9, 11, 22, .96);
}

html[data-performance-mode="lightweight"] #aboutPage .sgx-leaf::after,
html[data-sg-effects="reduced"] #aboutPage .sgx-leaf::after { animation: none; opacity: 0; }

html[data-sg-dark="oled"] #aboutPage .sgx-leaf {
    background: linear-gradient(180deg, rgba(7, 7, 14, .92), rgba(0, 0, 0, .96));
}

@keyframes sgxLineIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
@keyframes sgxArtIn { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
@keyframes sgxCaret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
@keyframes sgxContentIn { from { opacity: 0; transform: translateX(8px); } to { opacity: 1; transform: none; } }
@keyframes sgxStepIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
@keyframes sgxKeepIn { from { opacity: .45; transform: scale(.992); } to { opacity: 1; transform: none; } }
@keyframes sgxInRight { from { opacity: 0; transform: translateX(12px); } to { opacity: 1; transform: none; } }
@keyframes sgxInDown { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
@keyframes sgxGlitch {
    0% { transform: none; opacity: 1; }
    30% { transform: translateX(-1px); opacity: .88; }
    60% { transform: translateX(1px); opacity: .96; }
    100% { transform: none; opacity: 1; }
}
@keyframes sgxSeamRow { 0% { opacity: 0; transform: translateX(-50%) scaleY(0); } 45% { opacity: .9; transform: translateX(-50%) scaleY(1); } 100% { opacity: 0; transform: translateX(-50%) scaleY(1); } }
@keyframes sgxSeamCol { 0% { opacity: 0; transform: translateY(-50%) scaleX(0); } 45% { opacity: .9; transform: translateY(-50%) scaleX(1); } 100% { opacity: 0; transform: translateY(-50%) scaleX(1); } }
@keyframes sgxSheen { 0% { opacity: 0; transform: translateX(-120%); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateX(120%); } }
