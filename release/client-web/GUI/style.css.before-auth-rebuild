/* Account-scoped activity history */
.history-workspace {
    position: absolute;
    z-index: 2;
    inset: 78px 0 0;
    height: calc(100vh - 78px);
    display: flex;
    overflow: hidden;
    padding: 30px clamp(22px, 5vw, 72px) 105px;
    flex-direction: column;
    color: #e7f2f7;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
}

.history-page-heading {
    display: flex;
    width: min(1240px, 100%);
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0 auto 18px;
}

.history-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: #79a0ad;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .15em;
}

.history-eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #49d9ee;
    box-shadow: 0 0 10px #21bdd4;
}

.history-page-heading h1 {
    margin: 0;
    color: #eff8fb;
    font-size: clamp(25px, 3vw, 34px);
    font-weight: 570;
    letter-spacing: -.04em;
}

.history-page-heading > div > p:last-child {
    margin: 7px 0 0;
    color: #8ca4ad;
    font-size: 13px;
}

.history-refresh,
.history-detail-button,
.history-primary-action,
.history-dialog-close {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 15px;
    border: 1px solid rgba(91, 203, 225, .22);
    border-radius: 11px;
    background: rgba(14, 42, 52, .74);
    color: #9ce8f3;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color .2s, background .2s, color .2s, transform .2s;
}

.history-refresh:hover,
.history-detail-button:hover,
.history-primary-action:hover,
.history-dialog-close:hover {
    transform: translateY(-1px);
    border-color: rgba(76, 220, 241, .55);
    background: rgba(16, 67, 82, .78);
    color: #e0fbff;
}

.history-refresh span {
    font-size: 18px;
}

.history-panel {
    display: flex;
    width: min(1240px, 100%);
    min-height: 0;
    margin: 0 auto;
    flex: 1 1 auto;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(123, 196, 215, .15);
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(13, 31, 39, .92), rgba(8, 22, 29, .91));
    box-shadow: inset 0 1px rgba(255,255,255,.035), 0 18px 44px rgba(0,0,0,.16);
}

.history-toolbar {
    display: flex;
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(123, 196, 215, .1);
}

.history-toolbar > div {
    display: flex;
    align-items: baseline;
    gap: 12px;
}

.history-toolbar > div strong {
    color: #e5f1f4;
    font-size: 15px;
}

.history-toolbar > div span {
    color: #78939d;
    font-size: 11px;
}

.history-filter-label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #849da6;
    font-size: 11px;
}

.history-filter-label select {
    min-width: 142px;
    min-height: 44px;
    padding: 0 34px 0 12px;
    border: 1px solid rgba(123, 196, 215, .18);
    border-radius: 9px;
    outline: none;
    background: #0b1c24;
    color: #d7e9ed;
    font: inherit;
    font-size: 12px;
}

.history-list {
    display: flex;
    min-height: 0;
    padding: 14px 16px 18px;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 10px;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-color: rgba(90, 169, 190, .34) transparent;
    scrollbar-width: thin;
}

.history-row {
    display: flex;
    min-width: 0;
    padding: 14px 15px 11px;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 12px;
    border: 1px solid rgba(123, 196, 215, .11);
    border-radius: 13px;
    background: rgba(3, 15, 21, .43);
    transition: border-color .2s, background .2s;
}

.history-row:hover {
    border-color: rgba(75, 203, 225, .25);
    background: rgba(8, 29, 38, .72);
}

.history-row-top {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.history-file-name {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
}

.history-file-name strong {
    overflow: hidden;
    color: #e5f2f5;
    font-size: 14px;
    font-weight: 620;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.history-file-name small {
    color: #708c96;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.history-status {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    flex: 0 0 auto;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 650;
}

.history-status::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    content: "";
}

.history-status.is-processing {
    border-color: rgba(62, 182, 255, .18);
    background: rgba(36, 124, 255, .09);
    color: #7fc9ff;
}

.history-status.is-processing::before {
    opacity: .9;
}

.history-status.is-completed {
    border-color: rgba(74, 220, 177, .18);
    background: rgba(44, 184, 135, .08);
    color: #76e1b8;
}

.history-status.is-failed {
    border-color: rgba(255, 115, 139, .2);
    background: rgba(232, 63, 94, .09);
    color: #ff9aaa;
}

@keyframes history-pulse {
    50% { opacity: .35; box-shadow: 0 0 0 5px rgba(75, 164, 255, .11); }
}

.history-metadata {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
}

.history-field {
    display: flex;
    min-width: 0;
    min-height: 48px;
    padding: 7px 9px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    border-radius: 8px;
    background: rgba(127, 185, 200, .045);
}

.history-field > span {
    color: #718c96;
    font-size: 9px;
}

.history-field > strong {
    overflow: hidden;
    color: #c6d9de;
    font-size: 11px;
    font-weight: 550;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.history-row-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: -2px;
}

.history-detail-button {
    min-height: 42px;
    padding-inline: 16px;
    font-size: 11px;
}

.history-state {
    display: flex;
    min-height: 190px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    flex-direction: column;
    color: #78939d;
    text-align: center;
}

.history-state strong {
    color: #b3c8ce;
    font-size: 13px;
    font-weight: 550;
}

.history-state small {
    max-width: 480px;
    padding-inline: 14px;
    color: #718b95;
    font-size: 11px;
    line-height: 1.5;
}

.history-state-icon {
    color: #61d8eb;
    font-size: 29px;
}

.history-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid rgba(98, 216, 235, .18);
    border-top-color: #62d8eb;
    border-radius: 50%;
    animation: history-spin .8s linear infinite;
}

@keyframes history-spin {
    to { transform: rotate(360deg); }
}

.history-dialog {
    width: min(680px, calc(100vw - 30px));
    max-width: none;
    max-height: min(82vh, 760px);
    overflow: auto;
    padding: 22px;
    border: 1px solid rgba(102, 206, 226, .23);
    border-radius: 18px;
    background: linear-gradient(145deg, #10242d, #09171e 78%);
    box-shadow: 0 24px 80px rgba(0,0,0,.55), inset 0 1px rgba(255,255,255,.04);
    color: #e4f1f4;
}

.history-dialog::backdrop {
    background: rgba(2, 8, 12, .76);
    backdrop-filter: blur(7px);
}

.history-dialog-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 17px;
}

.history-dialog-heading p {
    margin: 0 0 6px;
    color: #76a2b0;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .14em;
}

.history-dialog-heading h2 {
    max-width: 520px;
    margin: 0;
    overflow-wrap: anywhere;
    color: #edf8fa;
    font-size: 19px;
    font-weight: 600;
}

.history-dialog-close {
    width: 44px;
    height: 44px;
    padding: 0;
    flex: 0 0 44px;
    border-radius: 12px;
    font-size: 22px;
}

.history-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}

.history-detail-grid .history-field {
    min-height: 58px;
    padding: 10px 12px;
}

.history-detail-grid .history-field:first-child {
    grid-column: 1 / -1;
}

.history-detail-grid .history-field > span {
    font-size: 10px;
}

.history-detail-grid .history-field > strong {
    font-size: 12px;
}

.history-dialog-feedback {
    min-height: 18px;
    margin: 12px 0 0;
    color: #86a6af;
    font-size: 11px;
}

.history-dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 8px;
}

.history-primary-action {
    min-height: 50px;
    padding-inline: 18px;
    border-color: rgba(76, 213, 233, .35);
    background: linear-gradient(105deg, #136d91, #275dcc 58%, #7046c1);
    box-shadow: 0 6px 20px rgba(33, 143, 216, .18);
    color: #f2fdff;
    font-size: 13px;
}

@media (max-width: 760px) {
    .history-workspace {
        inset: 66px 0 0;
        height: calc(100vh - 66px);
        padding: 20px 14px 96px;
    }

    .history-page-heading {
        gap: 10px;
        margin-bottom: 13px;
    }

    .history-page-heading h1 {
        font-size: 24px;
    }

    .history-page-heading > div > p:last-child {
        max-width: 440px;
        font-size: 11px;
    }

    .history-eyebrow {
        font-size: 8px;
    }

    .history-refresh {
        min-height: 44px;
        padding-inline: 11px;
        font-size: 10px;
    }

    .history-toolbar {
        min-height: 62px;
        padding: 9px 11px;
    }

    .history-toolbar > div {
        flex-wrap: wrap;
        gap: 4px 8px;
    }

    .history-toolbar > div strong {
        font-size: 13px;
    }

    .history-toolbar > div span,
    .history-filter-label {
        font-size: 9px;
    }

    .history-filter-label {
        gap: 5px;
    }

    .history-filter-label select {
        min-width: 106px;
        min-height: 44px;
        padding-inline: 8px 25px;
        font-size: 10px;
    }

    .history-list {
        padding: 10px;
        gap: 8px;
    }

    .history-row {
        padding: 11px;
        gap: 9px;
    }

    .history-file-name strong {
        font-size: 12px;
    }

    .history-file-name small {
        font-size: 9px;
    }

    .history-status {
        min-height: 28px;
        padding-inline: 8px;
        font-size: 9px;
    }

    .history-metadata {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px;
    }

    .history-field {
        min-height: 46px;
        padding: 6px 8px;
    }

    .history-field > span {
        font-size: 8px;
    }

    .history-field > strong {
        font-size: 10px;
    }

    .history-dialog {
        padding: 15px;
    }
}

@media (max-width: 420px) {
    .history-workspace {
        padding: 14px 9px 92px;
    }

    .history-page-heading h1 {
        font-size: 21px;
    }

    .history-page-heading > div > p:last-child {
        font-size: 10px;
    }

    .history-refresh {
        gap: 4px;
        padding-inline: 8px;
    }

    .history-toolbar {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
    }

    .history-filter-label {
        width: 100%;
        justify-content: space-between;
    }

    .history-filter-label select {
        flex: 1;
    }

    .history-dialog-heading h2 {
        font-size: 16px;
    }

    .history-detail-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .history-detail-grid .history-field:first-child {
        grid-column: auto;
    }

    .history-dialog-actions,
    .history-dialog-actions button {
        width: 100%;
    }
}

@media (min-width: 761px) and (max-width: 1000px) {
    .history-workspace {
        padding-inline: 24px;
    }

    .history-metadata {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}


/* Shared interaction feedback states */
.app-notice {
    position: fixed; z-index: 12000; top: 20px; left: 50%; display: flex; width: min(560px, calc(100vw - 32px)); min-height: 54px; align-items: center; gap: 12px; padding: 11px 14px; transform: translateX(-50%);
    border: 1px solid rgba(87, 195, 219, .28); border-radius: 14px; background: rgba(8, 23, 31, .94); box-shadow: 0 16px 48px rgba(0, 0, 0, .4), inset 0 1px rgba(255,255,255,.04);
    color: #c9dce2; font-family: Arial, sans-serif; font-size: 13px; line-height: 1.45; backdrop-filter: blur(10px); animation: notice-in .2s ease-out both;
}
.app-notice.is-error { border-color: rgba(255, 117, 143, .38); }
.app-notice.is-success { border-color: rgba(83, 224, 184, .38); }
.app-notice-mark { display: grid; width: 25px; height: 25px; flex: 0 0 25px; place-items: center; border-radius: 50%; background: rgba(255, 117, 143, .14); color: #ff9bad; }
.app-notice-mark::before { content: "!"; font: 700 14px Arial, sans-serif; }
.app-notice.is-success .app-notice-mark { background: rgba(83, 224, 184, .13); color: #72e6c3; }
.app-notice.is-success .app-notice-mark::before { content: "✓"; }
.app-notice button { width: 32px; height: 32px; flex: 0 0 32px; margin-left: auto; border: 0; border-radius: 8px; background: transparent; color: #829da7; font: 22px Arial, sans-serif; cursor: pointer; }
.app-notice button:hover { background: rgba(255,255,255,.07); color: #e9f7fa; }
@keyframes notice-in { from { opacity: 0; transform: translate(-50%, -8px); } to { opacity: 1; transform: translate(-50%, 0); } }
.form-status { margin: 0; padding: 11px 13px; border: 1px solid rgba(255, 117, 143, .24); border-radius: 10px; background: rgba(255, 82, 113, .07); color: #ffabb8; font: 12px/1.5 Arial, sans-serif; }
.auth-form[aria-busy="true"] { cursor: progress; }
.auth-form[aria-busy="true"] button[type="submit"] { opacity: .76; cursor: progress; }
.music-search-status { min-height: 30px; display: flex; align-items: center; gap: 7px; padding: 6px 8px; border-radius: 8px; font: 11px/1.4 Arial, sans-serif; }
.music-search-status.is-error { border: 1px solid rgba(255, 117, 143, .17); background: rgba(255, 82, 113, .055); color: #ff9eae; }
.music-search-status.is-success { color: #83e3c4; }
.music-search-status.is-empty { color: #89a3ad; }
.music-search-status.is-loading::before, .restore-empty-state.is-loading::before { content: ""; width: 14px; height: 14px; flex: 0 0 14px; border: 2px solid rgba(91, 211, 232, .2); border-top-color: #63dced; border-radius: 50%; animation: history-spin .75s linear infinite; }
.restore-empty-state.is-loading { flex-direction: row; min-height: 100px; font: 12px Arial, sans-serif; }
.restore-empty-state.is-error { border-color: rgba(255, 117, 143, .26); background: rgba(255, 82, 113, .035); color: #ffabb8; }
.restore-empty-state.is-error strong { color: #ffabb8; font: 12px/1.5 Arial, sans-serif; }
.restore-empty-state.is-error button { min-height: 42px; margin-top: 5px; }
.restore-empty-state.is-empty { border-color: rgba(123, 196, 215, .2); background: rgba(30, 89, 104, .035); }
