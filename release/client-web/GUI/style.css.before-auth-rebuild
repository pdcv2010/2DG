    .settings-choices button,
    .settings-action,
    .settings-storage-bar i { transition: none; }
}
/* ==================================================================
   LIQUID GLASS AURORA - SentinelGate visual system.
   Presentation only: no markup logic, routing, data or API is changed.
   Motion uses transform/opacity only; the aurora fields hold still for
   most of their cycle so the compositor produces very few frames.
   ================================================================== */
:root {
    --glass-blur: 15px;
    --glass-blur-strong: 24px;
    --glass-bg: linear-gradient(180deg, rgba(255, 255, 255, .105), rgba(255, 255, 255, .045));
    --glass-bg-hover: linear-gradient(180deg, rgba(255, 255, 255, .155), rgba(255, 255, 255, .07));
    --glass-border: rgba(255, 255, 255, .12);
    --glass-border-strong: rgba(255, 255, 255, .2);
    --glass-highlight: rgba(255, 255, 255, .14);
    --glass-shadow: 0 16px 40px rgba(0, 0, 0, .42);
    --glass-shadow-lift: 0 22px 54px rgba(0, 0, 0, .5);
    --glass-tint: rgba(34, 211, 238, .07);
    --glass-tint-strong: rgba(34, 211, 238, .12);
    --aurora-cyan: rgba(34, 211, 238, .2);
    --aurora-blue: rgba(59, 130, 246, .17);
    --aurora-violet: rgba(129, 92, 246, .13);
    --sg-ease: cubic-bezier(.16, 1, .3, 1);
    --sg-ease-tab: cubic-bezier(.22, .61, .36, 1);
    --sg-sheen: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, .13) 44%, rgba(255, 255, 255, .035) 56%, transparent 100%);
}

.sg-aurora {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(140% 90% at 50% -10%, #0b1826 0%, #070d15 44%, #03060a 100%);
}

.sg-aurora > span {
    position: absolute;
    display: block;
    border-radius: 50%;
    will-change: transform;
}

.sg-aurora > span:nth-child(1) {
    top: -24vw;
    left: -14vw;
    width: 64vw;
    height: 64vw;
    background: radial-gradient(circle at 50% 50%, var(--aurora-cyan), transparent 66%);
    animation: sgDriftA 150s ease-in-out infinite;
}

.sg-aurora > span:nth-child(2) {
    right: -18vw;
    bottom: -28vw;
    width: 74vw;
    height: 74vw;
    background: radial-gradient(circle at 50% 50%, var(--aurora-blue), transparent 67%);
    animation: sgDriftB 190s ease-in-out infinite;
}

.sg-aurora > span:nth-child(3) {
    top: 28%;
    right: 12%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle at 50% 50%, var(--aurora-violet), transparent 68%);
    animation: sgDriftC 230s ease-in-out infinite;
}

.sg-aurora::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 100% at 50% 44%, transparent 50%, rgba(0, 0, 0, .62) 100%);
}

/* Each field moves for only ~8% of its cycle, then holds perfectly still,
   and the three holds never overlap - so at most one layer is animating. */
@keyframes sgDriftA {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    8%, 40% { transform: translate3d(2.5vw, 2vh, 0) scale(1.06); }
    48% { transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes sgDriftB {
    0%, 34% { transform: translate3d(0, 0, 0) scale(1.04); }
    42%, 74% { transform: translate3d(-2.5vw, -2vh, 0) scale(1); }
    82%, 100% { transform: translate3d(0, 0, 0) scale(1.04); }
}

@keyframes sgDriftC {
    0%, 67% { transform: translate3d(0, 0, 0) scale(1); }
    75% { transform: translate3d(-1.5vw, 2.5vh, 0) scale(1.05); }
    83%, 100% { transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes sgRise {
    from { opacity: 0; translate: 0 16px; }
    to { opacity: 1; translate: 0 0; }
}

@keyframes sgRiseSoft {
    from { opacity: 0; translate: 0 10px; }
    to { opacity: 1; translate: 0 0; }
}

@keyframes sgSlideRight {
    from { opacity: 0; translate: 24px 0; scale: .985; }
    to { opacity: 1; translate: 0 0; scale: 1; }
}

@keyframes sgPopIn {
    from { opacity: 0; scale: .92; }
    to { opacity: 1; scale: 1; }
}

@keyframes sgDockIn {
    from { opacity: 0; translate: -50% 14px; }
    to { opacity: 1; translate: -50% 0; }
}

@keyframes sgSheenSweep {
    from { transform: translateX(-130%); opacity: 0; }
    25% { opacity: 1; }
    to { transform: translateX(130%); opacity: 0; }
}

@keyframes sgPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .45; }
}

@keyframes sgShimmer {
    from { transform: translateX(-120%); }
    to { transform: translateX(220%); }
}

