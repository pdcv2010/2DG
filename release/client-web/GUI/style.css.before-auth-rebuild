/* Storage & data actions. */
.settings-storage-bar {
    display: flex;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(123, 196, 215, .12);
}

.settings-storage-bar i {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--sg-accent-soft), var(--sg-accent));
    transition: width .25s ease;
}

.settings-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.settings-action {
    min-height: 42px;
    padding: 0 15px;
    border: 1px solid rgba(123, 196, 215, .2);
    border-radius: 10px;
    background: rgba(14, 42, 52, .6);
    color: #a9e6f1;
    font: 600 .75em Arial, sans-serif;
    cursor: pointer;
    transition: border-color .2s, background .2s, color .2s;
}

.settings-action:hover { border-color: var(--sg-accent-soft); color: #e0fbff; }
.settings-action:focus-visible { outline: 2px solid var(--sg-accent); outline-offset: 2px; }
.settings-action[disabled] { opacity: .5; cursor: not-allowed; }
.settings-action.is-danger { border-color: rgba(255, 140, 160, .24); background: rgba(255, 117, 143, .09); color: #ffc0ca; }
.settings-action.is-danger:hover { border-color: rgba(255, 140, 160, .5); background: rgba(255, 117, 143, .16); }
.settings-action[data-pending="true"] { border-color: rgba(255, 140, 160, .6); background: rgba(255, 117, 143, .2); color: #ffd9e0; }
.settings-import-input { display: none; }

/* Dark mode (OLED): deepens base surfaces only - no layout or text changes. */
html[data-sg-dark="oled"] body { background: #000; }
