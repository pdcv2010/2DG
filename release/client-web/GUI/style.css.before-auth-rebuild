    .settings-choices { flex: 1 1 100%; }
    .settings-choices button { flex: 1 1 auto; justify-content: center; }
    .settings-actions { flex-direction: column; }
    .settings-action { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
    .settings-switch,
