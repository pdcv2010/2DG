/* Settings control vocabulary: rows, switches, choice groups, badges. */
.settings-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.settings-row {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 14px;
    flex-wrap: wrap;
    border: 1px solid rgba(123, 196, 215, .12);
    border-radius: 13px;
    background: rgba(3, 15, 21, .43);
}

.settings-row.is-unavailable {
    border-style: dashed;
    background: rgba(3, 15, 21, .28);
}

.settings-row-copy {
    display: flex;
    min-width: 0;
    flex: 1 1 240px;
    flex-direction: column;
    gap: 4px;
}

.settings-row-copy strong { color: #e2eff3; font-size: .8125em; font-weight: 600; }
.settings-row-copy small { color: #829ba4; font-size: .6875em; line-height: 1.5; }
.settings-row.is-unavailable .settings-row-copy strong { color: #c3d5da; }

.settings-switch {
    display: inline-flex;
    min-width: 112px;
    min-height: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    padding: 0 11px;
    border: 1px solid rgba(123, 196, 215, .16);
    border-radius: 999px;
    background: rgba(123, 196, 215, .06);
    color: #9cb8c1;
    font: 600 .6875em Arial, sans-serif;
    cursor: pointer;
    transition: border-color .2s, background .2s, color .2s;
}

.settings-switch-label { order: -1; }

.settings-switch-track {
    position: relative;
    width: 34px;
    height: 18px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: rgba(123, 196, 215, .2);
    transition: background .2s;
}

.settings-switch-track::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #7d98a1;
    transition: transform .2s, background .2s;
}

.settings-switch[aria-checked="true"] { border-color: var(--sg-accent-soft); background: var(--sg-accent-fill); color: var(--sg-accent-text); }
.settings-switch[aria-checked="true"] .settings-switch-track { background: var(--sg-accent-soft); }
.settings-switch[aria-checked="true"] .settings-switch-track::after { transform: translateX(16px); background: var(--sg-accent); }
.settings-switch:hover { border-color: var(--sg-accent-soft); }
.settings-switch:focus-visible { outline: 2px solid var(--sg-accent); outline-offset: 2px; }

.settings-choices {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
}

.settings-choices button {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    border: 1px solid rgba(123, 196, 215, .16);
    border-radius: 10px;
    background: rgba(123, 196, 215, .05);
    color: #9cb8c1;
    font: 600 .6875em Arial, sans-serif;
    cursor: pointer;
    transition: border-color .2s, background .2s, color .2s;
}

.settings-choices button i { width: 11px; height: 11px; border-radius: 50%; background: currentColor; }
.settings-choices button[data-swatch="cyan"] i { background: #00d9ff; }
.settings-choices button[data-swatch="magenta"] i { background: #ff4dd2; }
.settings-choices button[data-swatch="lime"] i { background: #8bff5a; }
.settings-choices button[data-swatch="amber"] i { background: #ffb347; }
.settings-choices button:hover { border-color: rgba(123, 196, 215, .34); color: #d7e9ed; }
.settings-choices button.is-selected { border-color: var(--sg-accent-soft); background: var(--sg-accent-fill); color: var(--sg-accent-text); }
.settings-choices button:focus-visible { outline: 2px solid var(--sg-accent); outline-offset: 2px; }

.settings-badge {
    display: inline-flex;
    min-height: 27px;
    align-items: center;
    padding: 0 10px;
    border: 1px solid rgba(240, 193, 92, .2);
    border-radius: 999px;
    background: rgba(240, 193, 92, .07);
    color: #f3d08a;
    font: 600 .6875em Arial, sans-serif;
    white-space: nowrap;
