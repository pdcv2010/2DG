/* ------------------------------------------------------------------
   LIQUID GLASS SYSTEM - four depth levels.
   Only cosmetic properties are overridden (background layers, border
   colour, shadow, blur, transition). No layout, size or padding is
   touched, so every existing responsive rule keeps working.
   The specular sheen is a background layer, so no decorative
   pseudo-element is ever clobbered.
   ------------------------------------------------------------------ */

/* LEVEL 2 - standard glass cards */
.feature-card,
.account-summary,
.protect-panel,
.file-dropzone,
.history-panel,
.vault-file-card,
.history-row,
.settings-panel,
.about-panel,
.settings-row,
.restore-workflow,
.restore-file-item,
.music-result,
.mode-toggle {
    background-image: var(--sg-sheen), var(--glass-bg), radial-gradient(120% 110% at 100% 0%, var(--sg-tint, var(--glass-tint)), transparent 62%);
    background-size: 240% 100%, 100% 100%, 100% 100%;
    background-position: 100% 0, 0 0, 0 0;
    background-repeat: no-repeat;
    border-color: var(--glass-border);
    box-shadow: var(--glass-shadow), inset 0 1px var(--glass-highlight);
    backdrop-filter: blur(var(--glass-blur)) saturate(115%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(115%);
    transition: transform .24s var(--sg-ease-tab), border-color .24s var(--sg-ease-tab), box-shadow .24s var(--sg-ease-tab), background-position .8s var(--sg-ease-tab), filter .24s var(--sg-ease-tab);
}

/* LEVEL 1 - floating navigation dock */
.dashboard-dock {
    border-color: var(--glass-border-strong);
    background-image: var(--glass-bg), radial-gradient(120% 140% at 50% 120%, var(--glass-tint), transparent 60%);
    background-position: 0 0, 0 0;
    background-repeat: no-repeat;
    box-shadow: 0 20px 52px rgba(0, 0, 0, .55), inset 0 1px var(--glass-highlight);
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(125%);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(125%);
}

.tool-nav-label {
    border-color: var(--glass-border);
    background: rgba(8, 16, 24, .9);
    box-shadow: 0 10px 26px rgba(0, 0, 0, .45), inset 0 1px var(--glass-highlight);
}

/* LEVEL 3 - active, selected and hovered surfaces */
.feature-card:hover,
.vault-file-card:hover,
.history-row:hover,
.restore-file-item:hover,
.music-result:hover,
.file-dropzone:hover,
.file-dropzone.is-dragover,
.mode-toggle:hover {
    background-image: var(--sg-sheen), var(--glass-bg-hover), radial-gradient(120% 110% at 100% 0%, var(--sg-tint, var(--glass-tint-strong)), transparent 62%);
    background-position: 0% 0, 0 0, 0 0;
    border-color: var(--glass-border-strong);
    box-shadow: var(--glass-shadow-lift), inset 0 1px var(--glass-highlight);
    transform: translateY(-2px);
}

.tool-nav-item.is-current {
    border-color: rgba(34, 211, 238, .24);
    background: linear-gradient(180deg, rgba(34, 211, 238, .16), rgba(34, 211, 238, .05));
    color: #6ee7f5;
    box-shadow: inset 0 1px rgba(255, 255, 255, .12), 0 6px 18px rgba(34, 211, 238, .12);
}

.restore-file-item.is-selected,
.music-result.is-selected {
    border-color: rgba(34, 211, 238, .42);
    background-image: var(--glass-bg-hover), linear-gradient(90deg, rgba(34, 211, 238, .13), transparent 70%);
    background-position: 0 0, 0 0;
    box-shadow: 0 0 0 1px rgba(34, 211, 238, .16), inset 0 1px var(--glass-highlight);
}

/* LEVEL 4 - modal, notice and critical status surfaces */
.history-dialog,
.app-notice,
.processing-complete,
.processing-error {
    background-image: var(--glass-bg), radial-gradient(120% 120% at 100% 0%, var(--sg-tint, var(--glass-tint)), transparent 64%);
    background-position: 0 0, 0 0;
    background-repeat: no-repeat;
    border-color: var(--glass-border-strong);
    box-shadow: 0 30px 76px rgba(0, 0, 0, .6), inset 0 1px var(--glass-highlight);
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(120%);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(120%);
}

.processing-error { border-color: rgba(255, 117, 143, .32); }
.processing-complete { border-color: rgba(52, 211, 153, .3); }

/* Depth wells: recessed list areas read as carved into the glass. */
.history-list,
.vault-list,
.music-results-list,
.restore-jobs-list {
    border-radius: 14px;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, .035), rgba(255, 255, 255, .012));
    box-shadow: inset 0 1px rgba(0, 0, 0, .38), inset 0 -1px rgba(255, 255, 255, .04);
}

/* Restrained per-surface tint keeps identity without rainbow glow. */
.feature-protect { --sg-tint: rgba(34, 211, 238, .13); }
.feature-vault { --sg-tint: rgba(129, 92, 246, .11); }
.feature-history { --sg-tint: rgba(59, 130, 246, .12); }
