@font-face {
    font-family: 'Orbitron';
    src: url('./font/Orbitron/static/Orbitron-Bold.ttf') format('truetype');
    font-display: swap;
}
* {
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
}

body {
    overflow: hidden;
    background: #071014;
    color: #e4e3e9;
    font-family: 'Orbitron', sans-serif;
}

button,
input {
    font: inherit;
}

button {
    color: inherit;
}

.hidden {
    display: none !important;
}

.splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #071014;
}

.logo {
    width: 165px;
    height: 165px;
    object-fit: contain;
    opacity: 0;
    animation: logo-intro 1.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes logo-intro {
    0% { opacity: 0; transform: scale(0.25) rotate(-180deg); }
    45% { opacity: 1; transform: scale(1.12) rotate(25deg); }
    70% { transform: scale(0.96) rotate(-8deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

.loader {
    position: relative;
    width: 82px;
    height: 8px;
    margin-top: 12px;
    overflow: hidden;
    border-radius: 10px;
    background: rgba(120, 140, 150, 0.18);
    opacity: 0;
    animation: loader-show 0.5s ease forwards;
    animation-delay: 1.05s;
}

.loader-bar {
    position: absolute;
    top: 0;
    left: -45px;
    width: 42px;
    height: 100%;
    border-radius: 10px;
    background: linear-gradient(90deg, #743cff, #247cff, #00d9ff);
    animation: loader-slide 1.2s ease-in-out infinite;
}

@keyframes loader-slide {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(127px); }
}

@keyframes loader-show {
    from { opacity: 0; }
    to { opacity: 1; }
}

.auth-page {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #071014;
}

.auth-page::before {
    position: absolute;
    inset: 0;
    background: url("assets/background.png") center / cover no-repeat;
    content: "";
    opacity: 0.65;
}

.auth-page::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(circle at center, transparent 20%, rgba(3, 8, 11, 0.35) 70%, rgba(3, 8, 11, 0.75) 100%);
    content: "";
}

.auth-stage {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
}

#loginPage {
    position: absolute;
    inset: 0;
    z-index: 2;
}

.auth-container {
    position: relative;
    z-index: 2;
    isolation: isolate;
    display: flex;
    width: min(960px, calc(100vw - 32px));
    height: min(600px, calc(100vh - 32px));
    min-height: 540px;
    overflow: hidden;
    border: 1px solid rgba(127, 234, 255, 0.16);
    border-radius: 28px;
    background: #071014;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.48), 0 0 40px rgba(36, 124, 255, 0.08);
    font-family: Arial, Helvetica, sans-serif;
    background-image: var(--glass-bg);
    background-position: 0 0;
    background-repeat: no-repeat;
    border-color: var(--glass-border);
    box-shadow: 0 34px 90px rgba(0, 0, 0, .58), inset 0 1px var(--glass-highlight);
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(115%);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(115%);
}

.auth-container::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: #071014;
    content: "";
    pointer-events: none;
}

.welcome-panel,
.forms-panel {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
}

.welcome-panel {
    left: 0;
    z-index: 3;
    overflow: hidden;
    background: linear-gradient(120deg, #743cff 0%, #247cff 52%, #00d9ff 100%);
    border-radius: 28px 180px 180px 28px;
    color: #fff;
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1), border-radius 0.72s cubic-bezier(0.22, 1, 0.36, 1);
}

.forms-panel {
    right: 0;
    z-index: 2;
    overflow: hidden;
    background: rgba(10, 22, 27, 0.98);
}

.auth-stage.register-mode .welcome-panel,
.auth-stage.recovery-mode .welcome-panel {
    transform: translateX(100%);
    border-radius: 180px 28px 28px 180px;
}

.auth-stage.register-mode .forms-panel,
.auth-stage.recovery-mode .forms-panel {
    transform: translateX(-100%);
}

.welcome-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.28s ease, visibility 0.28s ease;
}

.welcome-copy.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
}

.welcome-copy h1 {
    margin: 0 0 14px;
    font-size: clamp(27px, 3vw, 38px);
    line-height: 1.15;
}

.welcome-copy p {
    margin: 0 0 25px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 16px;
}

.welcome-button {
    min-width: 150px;
    height: 50px;
    padding: 0 24px;
    border: 1.5px solid #fff;
    border-radius: 10px;
    background: transparent;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.welcome-button:hover {
    transform: translateY(-2px);
    background: #fff;
    color: #247cff;
}

.form-view {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 34px 48px;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.28s ease, visibility 0.28s ease;
}

.form-view.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
}

.auth-form {
    display: flex;
    width: 100%;
    max-width: 360px;
    flex-direction: column;
    gap: 12px;
    margin: 0;
}

.auth-form h2 {
    margin: 0 0 3px;
    color: #f6fbff;
    font-size: 30px;
    letter-spacing: 0.08em;
    text-align: center;
}

.form-subtitle {
    margin: -8px 0 2px;
    color: #9aabb5;
    font-size: 13px;
    text-align: center;
}

.auth-form input:not([type="checkbox"]) {
    width: 100%;
    height: 45px;
    padding: 0 14px;
    border: 1px solid rgba(127, 234, 255, 0.2);
    border-radius: 8px;
    outline: none;
    background: rgba(4, 14, 19, 0.82);
    color: #f4fbff;
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.auth-form input:not([type="checkbox"])::placeholder {
    color: #8299a5;
}

.auth-form input:not([type="checkbox"]):focus {
    border-color: #00d9ff;
    background: rgba(0, 217, 255, 0.06);
    box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.1);
}

.text-link {
    padding: 0;
    border: 0;
    background: transparent;
    color: #74dff4;
    font-size: 13px;
    text-decoration: none;
    cursor: pointer;
}

.text-link:hover {
    color: #fff;
    text-decoration: underline;
}

.forgot-link {
    align-self: flex-end;
    margin-top: -5px;
}

.primary-button {
    width: 100%;
    min-height: 47px;
    border: 0;
    border-radius: 9px;
    background: linear-gradient(90deg, #743cff, #247cff, #00d9ff);
    box-shadow: 0 8px 22px rgba(36, 124, 255, 0.23);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(0, 217, 255, 0.28);
}

.social-label {
    margin: 2px 0 0;
    color: #9aabb5;
    font-size: 12px;
    text-align: center;
}

.social-platforms {
    display: flex;
    justify-content: center;
    gap: 12px;
}

.social-button {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgba(127, 234, 255, 0.3);
    border-radius: 50%;
    background: rgba(4, 14, 19, 0.5);
    color: #e9f9ff;
    font-family: Arial, sans-serif;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
}

.social-button:hover {
    transform: translateY(-2px);
    border-color: #00d9ff;
    background: rgba(36, 124, 255, 0.18);
}

.social-facebook { font-family: Arial, sans-serif; font-size: 21px; }
.social-linkedin { font-size: 12px; }

.terms {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #aebdc5;
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 1.4;
}

.terms input {
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    margin: 1px 0 0;
    accent-color: #00d9ff;
}

.register-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 14px;
    margin-top: 1px;
    color: #9aabb5;
    font-size: 12px;
}

.register-footer span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

@media (max-width: 700px) {
    .auth-container {
        width: calc(100vw - 24px);
        height: min(600px, calc(100vh - 24px));
        min-height: 0;
        border-radius: 22px;
    }

    .welcome-copy { padding: 20px 12px; }
    .welcome-copy h1 { font-size: clamp(20px, 5vw, 28px); }
    .welcome-copy p { font-size: 13px; }
    .welcome-button { min-width: 120px; height: 44px; padding: 0 14px; }
    .form-view { padding: 24px 18px; }
    .auth-form { gap: 10px; }
    .auth-form h2 { font-size: 25px; }
    .auth-form input:not([type="checkbox"]) { height: 42px; padding: 0 10px; font-size: 13px; }
    .primary-button { min-height: 43px; }
    .social-platforms { gap: 7px; }
    .social-button { width: 34px; height: 34px; }
    .register-footer { justify-content: center; font-size: 11px; }
}

@media (max-width: 420px) {
    .auth-container { width: calc(100vw - 16px); height: min(620px, calc(100vh - 16px)); border-radius: 18px; }
    .welcome-copy { padding: 16px 8px; }
    .welcome-copy h1 { font-size: 21px; }
    .welcome-copy p { font-size: 12px; }
    .welcome-button { min-width: 105px; height: 40px; padding: 0 10px; font-size: 13px; }
    .form-view { padding: 18px 11px; }
    .auth-form { gap: 8px; }
    .auth-form h2 { font-size: 22px; }
    .form-subtitle { font-size: 11px; }
    .auth-form input:not([type="checkbox"]) { height: 39px; font-size: 12px; }
    .terms { gap: 5px; font-size: 9px; }
    .primary-button { min-height: 40px; font-size: 13px; }
    .social-label { font-size: 10px; }
    .social-button { width: 30px; height: 30px; }
}

@media (max-height: 620px) and (min-width: 701px) {
    .auth-container { height: calc(100vh - 24px); min-height: 0; }
    .form-view { align-items: flex-start; padding-top: 20px; padding-bottom: 20px; }
    .auth-form { gap: 8px; }
}

/* Recovery states share the same form panel and container as Login/Register. */
.recovery-content {
    gap: 18px;
}

.otp-container {
    display: flex;
    width: 100%;
    justify-content: center;
    gap: 8px;
}

.auth-form .otp {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    height: 52px;
    padding: 0;
    text-align: center;
    font-size: 20px;
}

.otp-links {
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

.password-strength {
    width: 100%;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(127, 234, 255, 0.14);
}

.strength-bar {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #743cff, #247cff, #00d9ff);
}

.password-rules {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #9aabb5;
    font-size: 12px;
}

.password-rules span:first-child {
    color: #dbeaf0;
    font-weight: 700;
}

.success-content h2 {
    line-height: 1.25;
}

@media (max-width: 700px) {
    .auth-form .otp { height: 42px; font-size: 17px; }
    .password-rules { font-size: 10px; }
}

/* SentinelGate Home dashboard */
.home-page {
    position: fixed;
    z-index: 5;
    inset: 0;
    overflow-x: hidden;
    overflow-y: auto;
    background:
        radial-gradient(ellipse at 78% -8%, rgba(36, 124, 255, 0.12), transparent 34%),
        radial-gradient(ellipse at 8% 90%, rgba(116, 60, 255, 0.08), transparent 30%),
        #071014;
    color: #e4edf2;
    font-family: Arial, Helvetica, sans-serif;
    scrollbar-width: none;
}

.home-page::-webkit-scrollbar {
    display: none;
}

.dashboard-dock {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: 22px;
    display: flex;
    width: max-content;
    max-width: calc(100vw - 24px);
    align-items: center;
    justify-content: center;
    padding: 9px 12px;
    transform: translateX(-50%);
    border: 1px solid rgba(145, 207, 224, 0.18);
    border-radius: 24px;
    background: rgba(10, 23, 30, 0.78);
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.48), inset 0 1px rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(22px) saturate(1.25);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
}

.tool-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow: visible;
}

.tool-nav-item {
    position: relative;
    display: grid;
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    place-items: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 15px;
    background: transparent;
    color: #94aab4;
    cursor: pointer;
}

.tool-nav-item.is-current {
    border-color: rgba(0, 217, 255, 0.14);
    background: rgba(0, 217, 255, 0.08);
    color: #4bdcf0;
}

.tool-nav-icon {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
}

.tool-nav-icon svg {
    display: block;
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
    transition: transform 0.25s ease;
}

.tool-nav-item:hover .tool-nav-icon svg {
    transform: translateY(-7px) scale(1.16);
}

.tool-nav-label {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 7px 10px;
    transform: translate(-50%, 5px);
    border: 1px solid rgba(145, 207, 224, 0.2);
    border-radius: 9px;
    background: rgba(8, 20, 26, 0.94);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
    color: #e1f2f6;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0;
    pointer-events: none;
    text-align: center;
    visibility: hidden;
    white-space: nowrap;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
    backdrop-filter: blur(16px);
}

.tool-nav-item:hover .tool-nav-label,
.tool-nav-item:focus-visible .tool-nav-label {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
}

.tool-nav-item:first-child .tool-nav-label {
    left: 0;
    transform: translate(0, 5px);
}

.tool-nav-item:first-child:hover .tool-nav-label,
.tool-nav-item:first-child:focus-visible .tool-nav-label {
    transform: translate(0, 0);
}

.tool-nav-item:last-child .tool-nav-label {
    right: 0;
    left: auto;
    transform: translate(0, 5px);
}

.tool-nav-item:last-child:hover .tool-nav-label,
.tool-nav-item:last-child:focus-visible .tool-nav-label {
    transform: translate(0, 0);
}

.tool-nav-item:focus-visible {
    outline: 2px solid #00d9ff;
    outline-offset: 2px;
}

.topbar-user > span {
    color: #d8faff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
}

.dashboard-main {
    min-height: 100vh;
    margin: 0;
    padding: 0 38px 126px;
}

.dashboard-topbar {
    display: flex;
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid rgba(120, 203, 222, 0.1);
}

.topbar-heading .eyebrow,
.eyebrow {
    margin: 0;
    color: #78919c;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
}

.topbar-heading .eyebrow span {
    margin: 0 6px;
    color: #00d9ff;
}

.topbar-heading h1 {
    margin: 6px 0 0;
    color: #eef8fc;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.025em;
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 18px;
}

.system-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #a7c0c7;
    font-size: 11px;
}

.system-status > span,
.device-status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #35e29a;
    box-shadow: 0 0 10px rgba(53, 226, 154, 0.6);
}

.topbar-icon-button,
.topbar-user {
    position: relative;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(120, 203, 222, 0.13);
    border-radius: 12px;
    background: rgba(13, 29, 35, 0.84);
    cursor: pointer;
}

.topbar-icon-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #adc2cb;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
}

.topbar-icon-button i {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #00d9ff;
}

.topbar-user {
    width: 40px;
    height: 40px;
    border-color: rgba(0, 217, 255, 0.2);
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(116, 60, 255, 0.36), rgba(0, 217, 255, 0.2));
}

.dashboard-content {
    width: min(100%, 1500px);
    margin: 0 auto;
}

.overview-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: 26px 0 20px;
}

.overview-intro .eyebrow { color: #6e8792; font-size: 9px; }

.overview-intro h2 {
    margin: 8px 0 5px;
    color: #f0f8fb;
    font-size: clamp(22px, 2.3vw, 29px);
    font-weight: 600;
    letter-spacing: -0.04em;
}

.overview-intro h2 span { color: #00d9ff; font-size: 18px; vertical-align: 4px; }
.overview-intro > div > p:last-child { margin: 0; color: #8ba1ab; font-size: 12px; }

.protection-badge,
.server-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid rgba(68, 222, 168, 0.2);
    border-radius: 999px;
    background: rgba(53, 226, 154, 0.08);
    color: #80e2bd;
    font-size: 10px;
    white-space: nowrap;
}

.protection-badge i,
.server-live i,
.activity-result i,
.server-detail-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: #42dfa5;
    box-shadow: 0 0 10px rgba(66, 223, 165, 0.5);
}

.stat-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.stat-card,
.dashboard-panel {
    border: 1px solid rgba(120, 203, 222, 0.12);
    border-radius: 15px;
    background: linear-gradient(145deg, rgba(14, 30, 36, 0.96), rgba(9, 22, 27, 0.94));
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15), inset 0 1px rgba(255, 255, 255, 0.015);
}

.file-stat-card {
    min-height: 150px;
    padding: 15px 16px;
}

.stat-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.stat-icon {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 10px;
    background: rgba(0, 217, 255, 0.08);
}

.stat-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
