.vault-file-card { --sg-tint: rgba(59, 130, 246, .05); }
.settings-panel { --sg-tint: rgba(34, 211, 238, .05); }
.about-panel { --sg-tint: rgba(34, 211, 238, .05); }
.protect-panel { --sg-tint: rgba(34, 211, 238, .06); }
.processing-error { --sg-tint: rgba(255, 92, 118, .16); }
.processing-complete { --sg-tint: rgba(52, 211, 153, .16); }
.sg-entering .dashboard-dock {
